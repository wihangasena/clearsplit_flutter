{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: Dart server",
            "type": "dart",
            "request": "launch",
            "program": "backend/bin/server.dart"
        },
        {
            "name": "Flutter: Run in Chrome",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "chrome"
        },
        {
            "name": "Flutter: Run (web-server)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "web-server",
            "args": ["--web-hostname", "127.0.0.1", "--web-port", "8080"]
        }
    ],
    "compounds": [
        {
            "name": "Run Backend + Flutter",
            "configurations": ["Backend: Dart server", "Flutter: Run in Chrome"]
        }
    ]
}